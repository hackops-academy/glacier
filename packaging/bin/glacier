#!/bin/bash
# glacier - launcher for the Glacier web security scanner (HackOps Academy)
#
# Installed by packaging/install.sh. Starts the intercepting proxy and the
# API server in the background, then launches the Electron HUD in the
# foreground. When the HUD window is closed, the background services are
# stopped automatically.
set -uo pipefail

GLACIER_HOME="${GLACIER_HOME:-$HOME/.local/share/glacier}"
RUN_DIR="$HOME/.local/share/glacier-run"
LOG_DIR="$RUN_DIR/logs"
LOCK_FILE="$RUN_DIR/glacier.lock"

mkdir -p "$LOG_DIR"

if [ ! -d "$GLACIER_HOME/venv" ]; then
    echo "[glacier] Not installed correctly - venv missing at $GLACIER_HOME/venv"
    echo "[glacier] Re-run the installer: ./packaging/install.sh"
    exit 1
fi

# --- prevent double-launch (stale proxy/API instances stepping on the same DB/port) ---
if [ -f "$LOCK_FILE" ]; then
    OLD_PID="$(cat "$LOCK_FILE" 2>/dev/null || true)"
    if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
        echo "[glacier] Glacier already appears to be running (pid $OLD_PID)."
        echo "[glacier] Close the existing HUD window first, or remove $LOCK_FILE if this is stale."
        exit 1
    fi
fi
echo $$ > "$LOCK_FILE"

PROXY_PID=""
API_PID=""

cleanup() {
    echo "[glacier] shutting down proxy and API..."
    [ -n "$PROXY_PID" ] && kill "$PROXY_PID" 2>/dev/null
    [ -n "$API_PID" ] && kill "$API_PID" 2>/dev/null
    rm -f "$LOCK_FILE"
}
trap cleanup EXIT INT TERM

echo "[glacier] starting proxy on 127.0.0.1:8081 ..."
(
    cd "$GLACIER_HOME/proxy" || exit 1
    exec "$GLACIER_HOME/venv/bin/mitmdump" -s addon.py -p 8081
) >"$LOG_DIR/proxy.log" 2>&1 &
PROXY_PID=$!

echo "[glacier] starting API on 127.0.0.1:8090 ..."
(
    cd "$GLACIER_HOME/api" || exit 1
    exec "$GLACIER_HOME/venv/bin/uvicorn" server:app --host 127.0.0.1 --port 8090
) >"$LOG_DIR/api.log" 2>&1 &
API_PID=$!

# give the API a moment to come up before the HUD tries to connect
sleep 1.5

if ! kill -0 "$PROXY_PID" 2>/dev/null; then
    echo "[glacier] WARNING: proxy failed to start - see $LOG_DIR/proxy.log"
fi
if ! kill -0 "$API_PID" 2>/dev/null; then
    echo "[glacier] WARNING: API failed to start - see $LOG_DIR/api.log"
fi

echo "[glacier] launching HUD..."
cd "$GLACIER_HOME/hud" || exit 1

if [ -x "./node_modules/.bin/electron" ]; then
    ./node_modules/.bin/electron . "$@"
elif command -v electron >/dev/null 2>&1; then
    electron . "$@"
else
    echo "[glacier] Electron not found in $GLACIER_HOME/hud/node_modules - reinstall Glacier."
    exit 1
fi

# cleanup runs automatically via the EXIT trap once the HUD window closes
